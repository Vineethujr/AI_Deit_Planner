# Copy this file to ".env" and fill in real values for your local setup.
# Never commit the actual ".env" file — it is already in .gitignore.

# --- Backend ---
FLASK_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=http://localhost:5173

# --- Optional AI API (fallback to rule-based engine if unset) ---
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages

# --- Cloud database / storage (local simulation by default) ---
DATABASE_PATH=./data/app.db
STORAGE_ROOT=./data/storage_bucket

# --- Frontend (see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:5000/api
